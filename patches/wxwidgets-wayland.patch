 namespace wxGTKImpl
 {
 
+// Remember the root coordinates of the last pointer event, used by
+// wxGetMousePosition() under Wayland where the global pointer position
+// can't be queried (defined in src/gtk/window.cpp).
+WXDLLIMPEXP_CORE void SetLastPointerPosition(double x_root, double y_root);
+
 // init wxMouseEvent with the info from GdkEventXXX struct
 template<typename T> void InitMouseEvent(wxWindowGTK *win,
                                          wxMouseEvent& event,
                                          T *gdk_event)
 {
+    SetLastPointerPosition(gdk_event->x_root, gdk_event->y_root);
+
     event.m_shiftDown = (gdk_event->state & GDK_SHIFT_MASK) != 0;
     event.m_controlDown = (gdk_event->state & GDK_CONTROL_MASK) != 0;
     event.m_altDown = (gdk_event->state & GDK_MOD1_MASK) != 0;
