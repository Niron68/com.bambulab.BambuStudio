     gdk_device_get_position(device, NULL, &x, &y);
+    wxGetLastWaylandPointerPosition(display, &x, &y);
     gdk_device_get_state(device, window, NULL, &mask);
 #else
     gdk_display_get_pointer(display, NULL, &x, &y, &mask);
@@ -6634,11 +6639,42 @@ wxWindow* wxFindWindowAtPointer(wxPoint& pt)
     return found;
 }
 
+#ifdef __WXGTK3__
+// Under Wayland, applications can't query the global pointer position: GDK
+// only knows the position relative to the surface under the pointer, which
+// isn't consistent with the root coordinates used by GetScreenPosition() and
+// ScreenToClient(), e.g. for popups. So remember the root coordinates of the
+// last pointer event received instead, which are consistent with them.
+static bool gs_hasLastPointerPos = false;
+static double gs_lastPointerX = 0, gs_lastPointerY = 0;
+
+WXDLLIMPEXP_CORE
+void wxGTKImpl::SetLastPointerPosition(double x_root, double y_root)
+{
+    gs_hasLastPointerPos = true;
+    gs_lastPointerX = x_root;
+    gs_lastPointerY = y_root;
+}
+
+static bool wxGetLastWaylandPointerPosition(GdkDisplay* display, int* x, int* y)
+{
+    if ( !gs_hasLastPointerPos || !wxGTKImpl::IsWayland(display) )
+        return false;
+    if ( x )
+        *x = wxRound(gs_lastPointerX);
+    if ( y )
+        *y = wxRound(gs_lastPointerY);
+    return true;
+}
+#endif // __WXGTK3__
+
 // Get the current mouse position.
 void wxGetMousePosition(int* x, int* y)
 {
     GdkDisplay* display = gdk_window_get_display(wxGetTopLevelGDK());
 #ifdef __WXGTK3__
+    if ( wxGetLastWaylandPointerPosition(display, x, y) )
+        return;
 #ifdef __WXGTK4__
     GdkSeat* seat = gdk_display_get_default_seat(display);
     GdkDevice* device = gdk_seat_get_pointer(seat);
